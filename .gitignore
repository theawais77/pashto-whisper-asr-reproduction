# Data — never commit the corpus. CC0 permits redistribution, but the archive
# is far too large for Git and for GCR. README documents the official source
# and prepare_data.py records its SHA-256.
data/raw/
data/processed/
*.mp3
*.wav
*.flac
*.tsv

# Model weights and checkpoints (~1 GB each)
results/*/checkpoint-*/
results/*/best/
*.safetensors
*.bin
*.pt
*.ckpt

